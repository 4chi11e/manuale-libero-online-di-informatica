---
import fs from 'node:fs/promises';
import path from 'node:path';

let wordCount = 0;
let charCount = 0;
let lineCount = 0;
let imageCount = 0;

async function countStats(dir) {
    const files = await fs.readdir(dir, { withFileTypes: true });
    for (const file of files) {
        const fullPath = path.join(dir, file.name);
        if (file.isDirectory()) {
            if (file.name === 'C' || file.name === 'Python') continue;
            await countStats(fullPath);
        } else if (file.name.endsWith('.md') || file.name.endsWith('.mdx')) {
            const content = await fs.readFile(fullPath, 'utf-8');
            charCount += content.length;
            lineCount += content.split('\n').length;
            
            const words = content.trim().split(/\s+/);
            if (words && words.length > 0 && words[0] !== "") {
                wordCount += words.length;
            }

            const imagesMd = content.match(/!\[.*?\]\(.*?\)/g);
            if (imagesMd) imageCount += imagesMd.length;
            const imagesHtml = content.match(/<img[^>]+>/g);
            if (imagesHtml) imageCount += imagesHtml.length;
        }
    }
}

try {
    const docsDir = path.join(process.cwd(), 'src', 'content', 'docs');
    await countStats(docsDir);
} catch (e) {
    console.error("Errore durante il conteggio delle statistiche:", e);
}

const formatNumber = (num) => new Intl.NumberFormat('it-IT').format(num);
---
<div class="site-stats-card">
    <h3>📊 Statistiche del Manuale</h3>
    <p>Questi dati sono aggiornati automaticamente a ogni build del sito (sono esclusi i manuali di C e Python, attualmente gestiti come documenti esterni):</p>
    <ul>
        <li><strong>Parole totali</strong> {formatNumber(wordCount)}</li>
        <li><strong>Caratteri totali</strong> {formatNumber(charCount)}</li>
        <li><strong>Righe di codice</strong> {formatNumber(lineCount)}</li>
        <li><strong>Immagini</strong> {formatNumber(imageCount)}</li>
    </ul>
</div>

<style>
